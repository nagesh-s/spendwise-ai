<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.spendwise.ai.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />
    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.spendwise.ai.calendar.CalendarFragment"
        android:label="Calendar"
        tools:layout="@layout/fragment_calendar" />
    <fragment
        android:id="@+id/navigation_categories"
        android:name="com.spendwise.ai.categories.CategoriesFragment"
        android:label="Categories"
        tools:layout="@layout/fragment_categories" />
    <fragment
        android:id="@+id/navigation_merchants"
        android:name="com.spendwise.ai.merchants.MerchantsFragment"
        android:label="Merchants"
        tools:layout="@layout/fragment_merchants" />
    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.spendwise.ai.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
    <dialog
        android:id="@+id/expenseEditorDialogFragment"
        android:name="com.spendwise.ai.common.ExpenseEditorDialogFragment"
        android:label="ExpenseEditorDialogFragment"
        tools:layout="@layout/fragment_expense_editor_dialog" />

    <fragment
        android:id="@+id/navigation_quick_tiles"
        android:name="com.spendwise.ai.quicktiles.QuickTilesFragment"
        android:label="Quick Tiles"
        tools:layout="@layout/fragment_quick_tiles" />

    <fragment
        android:id="@+id/navigation_recurring"
        android:name="com.spendwise.ai.recurring.RecurringExpensesFragment"
        android:label="Recurring Expenses"
        tools:layout="@layout/fragment_recurring_expenses" />

    <fragment
        android:id="@+id/navigation_goals"
        android:name="com.spendwise.ai.goals.GoalsFragment"
        android:label="Goals"
        tools:layout="@layout/fragment_goals" />

    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.spendwise.ai.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/navigation_auto_transactions"
        android:name="com.spendwise.ai.sms.AutoTransactionsFragment"
        android:label="Auto Transactions"
        tools:layout="@layout/fragment_auto_transactions" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.spendwise.ai.gamification.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>
